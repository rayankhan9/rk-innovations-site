@model List<Holiday>
@{ ViewData["Title"] = "Holidays"; int y = (int)ViewBag.Year; }
<div class="page-h"><h1>Holidays &amp; closures</h1>
    <div><a class="btn btn-sm btn-outline-secondary" asp-route-year="@(y - 1)">‹</a> <strong class="mx-2">@y</strong> <a class="btn btn-sm btn-outline-secondary" asp-route-year="@(y + 1)">›</a></div></div>
<p class="text-muted">Holidays are excluded from working days, so nobody is marked absent.</p>
<div class="row g-3">
    <div class="col-lg-7"><div class="card-x p-0"><table class="table mb-0 align-middle">
        <thead><tr><th>Date</th><th>Name</th><th></th></tr></thead><tbody>
        @foreach (var h in Model) {<tr><td>@h.Date.ToString("ddd, dd MMM yyyy")</td><td>@h.Name</td><td class="text-end"><form asp-action="Delete" asp-route-id="@h.Id" method="post"><button class="btn btn-sm btn-outline-danger">✕</button></form></td></tr>}
        @if (Model.Count == 0) {<tr><td colspan="3" class="text-center text-muted py-4">No holidays for @y.</td></tr>}
        </tbody></table></div></div>
    <div class="col-lg-5"><form asp-action="Add" method="post" class="card-x">
        <h2>Add holiday</h2>
        <div class="mb-2"><label class="form-label">Date</label><input type="date" name="date" class="form-control" required value="@y-01-01" /></div>
        <div class="mb-3"><label class="form-label">Name</label><input name="name" class="form-control" required maxlength="120" /></div>
        <button class="btn btn-primary">Add</button>
    </form></div>
</div>
