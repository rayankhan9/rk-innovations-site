@model ManualPunchVm
@{
    ViewData["Title"] = Model.Id == 0 ? "Manual entry" : "Edit attendance";
    var users = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Users;
    var sites = (List<Site>)ViewBag.Sites;
}
<div class="page-h"><h1>@ViewData["Title"]</h1></div>
<div class="alert alert-info small" style="max-width:640px">Manual changes are recorded in the audit log with your reason.</div>
<form method="post" class="card-x" style="max-width:640px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="UserId" class="form-label"></label><select asp-for="UserId" class="form-select"><option value="">Select…</option>@foreach (var u in users) {<option value="@u.Value" selected="@(u.Value == Model.UserId)">@u.Text</option>}</select></div>
        <div class="col-md-4"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="InTime" class="form-label"></label><input asp-for="InTime" type="time" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="OutTime" class="form-label"></label><input asp-for="OutTime" type="time" class="form-control" /></div>
        <div class="col-12"><label asp-for="SiteId" class="form-label">Location</label><select asp-for="SiteId" class="form-select"><option value="">—</option>@foreach (var s in sites) {<option value="@s.Id" selected="@(s.Id == Model.SiteId)">@s.Name</option>}</select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" placeholder="e.g. Phone dead, verified by supervisor" /></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
