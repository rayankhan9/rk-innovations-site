@model OrgSignupVm
@{ ViewData["Title"] = "Create organization"; }
<div class="auth-card">
    <h1>Create your organization</h1>
    <p class="text-muted small">You become the administrator. Members then join from the mobile app using a code.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-2"><label asp-for="OrgName" class="form-label"></label><input asp-for="OrgName" class="form-control" /><span asp-validation-for="OrgName" class="text-danger small"></span></div>
        <div class="row g-2 mb-2">
            <div class="col-6"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<OrgType>()" class="form-select"></select></div>
            <div class="col-6"><label class="form-label">Time zone</label><partial name="_TimeZones" model="Model.TimeZoneId" /></div>
        </div>
        <div class="mb-2"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
        <div class="mb-2"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="row g-2 mb-3">
            <div class="col-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="col-6"><label asp-for="Confirm" class="form-label"></label><input asp-for="Confirm" class="form-control" autocomplete="new-password" /><span asp-validation-for="Confirm" class="text-danger small"></span></div>
        </div>
        <button class="btn btn-primary w-100">Create organization</button>
    </form>
    <p class="mt-3 mb-0 small text-center"><a asp-action="Login">Back to sign in</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
