@model LoginVm
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-card">
    <div class="auth-logo"><img src="~/img/logo.svg" alt="" /><h1>AttendancePro</h1></div>
    <p class="text-muted">Admin portal sign in</p>
    <form method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-3"><label class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
        <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Keep me signed in</label></div>
        <button class="btn btn-primary w-100">Sign in</button>
    </form>
    @if ((bool)ViewBag.AllowSignup) { <p class="mt-3 mb-0 small text-center">New organization? <a asp-action="Signup">Set one up</a></p> }
    <p class="mt-2 mb-0 small text-muted text-center">Members use the mobile app, not this portal.</p>
</div>
