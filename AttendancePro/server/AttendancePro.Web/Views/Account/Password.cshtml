@model ChangePwVm
@{ ViewData["Title"] = "Change password"; }
<div class="page-h"><h1>Change password</h1></div>
<div class="card-x" style="max-width:460px">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
        <div class="mb-3"><label asp-for="Current" class="form-label"></label><input asp-for="Current" class="form-control" autocomplete="current-password" /></div>
        <div class="mb-3"><label asp-for="New" class="form-label"></label><input asp-for="New" class="form-control" autocomplete="new-password" /></div>
        <button class="btn btn-primary">Update</button>
    </form>
</div>
